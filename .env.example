# Shared application database. Local tools and the deployed app may use this same
# database, so local migrations, seeds, and tests can affect live data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Absolute path containing local episode video files. Nothing under this root is uploaded.
CURATOR_MEDIA_ROOT="/absolute/path/to/frieren/episodes"

# Optional local-only overrides.
# CURATOR_PORT=4317
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Local Connections AI authoring (server/tooling only; never NEXT_PUBLIC_).
OPENROUTER_API_KEY=""
# CONNECTIONS_GENERATOR_MODEL="google/gemini-3.1-flash-lite"
# CONNECTIONS_CRITIC_MODEL="openai/gpt-5-mini"

# Cloudflare R2 (server/tooling only; never prefix these with NEXT_PUBLIC_).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL="https://frames.example.com"

# Discord OAuth / Auth.js. Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="replace-with-a-random-auth-secret"
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Optional outside Vercel. Use the canonical HTTPS origin in production.
# AUTH_URL="https://frieren.oreotm.xyz"

# Optional public brand override: "default" or "nyamon". Leave unset for the date schedule.
# NEXT_PUBLIC_SITE_BRAND_OVERRIDE="nyamon"

# Discord user ID trusted to receive ADMIN on sign-in. Server-only; never NEXT_PUBLIC_.
ADMIN_DISCORD_ID=""

# Signs anonymous Unlimited game state. Generate with: openssl rand -base64 32
GUESSR_SESSION_SECRET="replace-with-at-least-32-random-characters"
